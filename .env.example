TILECAST_ENV=production
TILECAST_HTTP_ADDR=:8080
TILECAST_DATABASE_URL=postgres://tilecast:change-me@postgres:5432/tilecast?sslmode=disable
TILECAST_PUBLIC_URL=https://signage.example.org
TILECAST_COOKIE_SECURE=true
TILECAST_SESSION_TTL=24h
TILECAST_LOG_LEVEL=info
TILECAST_MDNS_ENABLED=false
TILECAST_MEDIA_ROOT=/data/media
TILECAST_MAX_UPLOAD_BYTES=10737418240
TILECAST_MEDIA_WORKERS=2
TILECAST_MEDIA_RESERVED_FREE_BYTES=1073741824
TILECAST_FFMPEG_PATH=/usr/bin/ffmpeg
TILECAST_FFPROBE_PATH=/usr/bin/ffprobe
TILECAST_VIDEO_MAX_WIDTH=1920
TILECAST_VIDEO_MAX_HEIGHT=1080
TILECAST_VIDEO_MAX_FRAME_RATE=60
TILECAST_KEEP_ORIGINALS=true
TILECAST_MAX_SCHEDULES=1000
TILECAST_MAX_SCHEDULE_TARGETS=250
TILECAST_MAX_GROUPS_PER_SCREEN=50
TILECAST_SCHEDULE_PREFETCH_DAYS=14
TILECAST_SCHEDULE_ACTIVATION_GRACE_SECONDS=30
TILECAST_CLOCK_SKEW_WARNING_SECONDS=300
POSTGRES_DB=tilecast
POSTGRES_USER=tilecast
POSTGRES_PASSWORD=change-me
# Optional: enable the `tunnel` Compose profile after creating a Cloudflare Tunnel.
CLOUDFLARE_TUNNEL_TOKEN=
