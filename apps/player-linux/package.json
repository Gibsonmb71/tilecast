{
  "name": "@gibsonmb71/tilecast-player-linux",
  "version": "0.2.4",
  "license": "AGPL-3.0-only",
  "description": "Tilecast Player for Linux kiosk devices",
  "author": "Gibsonmb71",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --config electron-builder.config.cjs --linux --publish never"
  },
  "dependencies": {
    "bonjour-service": "^1.4.3",
    "qrcode-generator": "^1.5.2",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@types/node": "^24.0.14",
    "@types/ws": "^8.18.1",
    "electron": "37.10.3",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "electron@37.10.3": true
  },
  "files": [
    "dist/**",
    "static/**"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gibsonmb71/tilecast.git",
    "directory": "apps/player-linux"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
