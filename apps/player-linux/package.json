{
  "name": "@gibsonmb71/tilecast-player-linux",
  "version": "0.1.0",
  "license": "AGPL-3.0-only",
  "description": "Tilecast Player for Linux kiosk devices",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -b",
    "start": "npm run build && electron .",
    "test": "vitest run",
    "dist": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "bonjour-service": "^1.4.3",
    "qrcode-generator": "^1.5.2",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.14",
    "@types/ws": "^8.18.1",
    "electron": "^37.2.3",
    "electron-builder": "^26.0.12",
    "typescript": "~5.8.3",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "org.tilecast.player",
    "productName": "Tilecast Player",
    "files": [
      "dist/**",
      "static/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo",
      "executableName": "tilecast-player"
    }
  },
  "allowScripts": {
    "electron@37.10.3": true
  },
  "files": [
    "dist/**",
    "static/**"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Gibsonmb71/tilecast.git",
    "directory": "apps/player-linux"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  }
}
