{
  "widgets": [
    {
      "id": "grafana",
      "version": 1,
      "name": "Grafana",
      "description": "Display a Grafana dashboard.",
      "category": "Dashboards",
      "icon": "grafana",
      "thumbnail": "grafana",
      "kind": "app",
      "featured": true,
      "keywords": ["metrics", "monitoring", "dashboard"],
      "runtime": "web",
      "configurationSchema": {
        "fields": [
          {
            "key": "dashboardUrl",
            "label": "Externally shared dashboard URL",
            "description": "Use Grafana's externally shared/public dashboard URL, not an authenticated editor URL.",
            "control": "url",
            "required": true
          },
          {
            "key": "trustedHost",
            "label": "Trusted Grafana host",
            "description": "Enter the exact hostname or IP address from the dashboard URL, without https://, a path, or a port. This explicitly approves that host for Player access.",
            "control": "text",
            "required": true,
            "maxLength": 253
          },
          {
            "key": "refreshIntervalSeconds",
            "label": "Reload interval",
            "control": "integer",
            "required": true,
            "minimum": 60,
            "maximum": 86400,
            "default": 300
          }
        ]
      },
      "defaultConfiguration": {
        "dashboardUrl": "",
        "trustedHost": "",
        "refreshIntervalSeconds": 300
      },
      "presentationSchemaVersion": 1,
      "requiredCapabilities": { "web.remote": 2 },
      "emptyStateBehavior": "placeholder",
      "webIntegration": {
        "urlField": "dashboardUrl",
        "allowAnyHttpsHost": true,
        "transform": "passthrough",
        "reloadIntervalField": "refreshIntervalSeconds",
        "loadTimeoutSeconds": 45,
        "lifecycle": "keep_warm",
        "warmSeconds": 90,
        "fallbackBehavior": "placeholder"
      },
      "setup": {
        "eyebrow": "Grafana",
        "steps": [
          "Create an externally shared dashboard in Grafana.",
          "Paste its HTTPS URL.",
          "Enter the URL's exact hostname or IP address to explicitly trust that destination."
        ],
        "tip": "Self-hosted and private-network Grafana hosts are supported only when you explicitly trust the exact host. Tilecast cannot bypass Grafana authentication, CSP, or embedding policy."
      },
      "deprecation": {}
    },
    {
      "id": "power-bi",
      "version": 1,
      "name": "Power BI",
      "description": "Display a Power BI report published to the web.",
      "category": "Dashboards",
      "icon": "power-bi",
      "thumbnail": "power-bi",
      "kind": "app",
      "keywords": ["microsoft", "analytics", "report"],
      "runtime": "web",
      "configurationSchema": {
        "fields": [
          {
            "key": "reportUrl",
            "label": "Publish to web URL",
            "description": "Only use a Power BI Publish to web link for information safe to make public.",
            "control": "url",
            "required": true
          },
          {
            "key": "refreshIntervalSeconds",
            "label": "Reload interval",
            "control": "integer",
            "required": true,
            "minimum": 60,
            "maximum": 86400,
            "default": 900
          }
        ]
      },
      "defaultConfiguration": {
        "reportUrl": "",
        "refreshIntervalSeconds": 900
      },
      "presentationSchemaVersion": 1,
      "requiredCapabilities": { "web.remote": 2 },
      "emptyStateBehavior": "placeholder",
      "webIntegration": {
        "urlField": "reportUrl",
        "allowedHosts": ["app.powerbi.com"],
        "requiredPathPrefix": "/view",
        "transform": "passthrough",
        "reloadIntervalField": "refreshIntervalSeconds",
        "loadTimeoutSeconds": 45,
        "lifecycle": "keep_warm",
        "warmSeconds": 90,
        "fallbackBehavior": "placeholder"
      },
      "setup": {
        "eyebrow": "Microsoft Power BI",
        "steps": [
          "Use File > Embed report > Publish to web.",
          "Paste the public app.powerbi.com/view link."
        ],
        "tip": "Publish to web makes the report public. Do not use it for confidential or personal data."
      },
      "deprecation": {}
    },
