POSTGRES_DB=tilecast
POSTGRES_USER=tilecast
POSTGRES_PASSWORD=replace-with-a-long-random-password
TILECAST_PORT=8080
TILECAST_PUBLIC_URL=http://tilecast.local:8080
# Set true only when the public URL is HTTPS.
TILECAST_COOKIE_SECURE=false
TILECAST_SESSION_TTL=24h
TILECAST_LOG_LEVEL=info
TILECAST_MDNS_ENABLED=false
TILECAST_MAX_UPLOAD_BYTES=10737418240
TILECAST_MEDIA_WORKERS=2
TILECAST_MEDIA_RESERVED_FREE_BYTES=1073741824
TILECAST_VIDEO_MAX_WIDTH=1920
TILECAST_VIDEO_MAX_HEIGHT=1080
TILECAST_VIDEO_MAX_FRAME_RATE=60
TILECAST_KEEP_ORIGINALS=true
# Required only with: docker compose --profile tunnel up -d
CLOUDFLARE_TUNNEL_TOKEN=
