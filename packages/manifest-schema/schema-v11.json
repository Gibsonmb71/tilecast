{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilecast.org/schemas/player-manifest-v11.json",
  "title": "Tilecast Widget and Data Source presentation manifest v11",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestVersion",
    "screenId",
    "generatedAt",
    "serverTime",
    "mode",
    "playlists",
    "layouts",
    "schedules",
    "assets",
    "websites",
    "widgets",
    "dataSources",
    "prefetchHorizonDays",
    "activationGraceSeconds"
  ],
  "properties": {
    "schemaVersion": { "const": 11 },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "screenId": { "type": "string", "format": "uuid" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "serverTime": { "type": "string", "format": "date-time" },
    "mode": { "const": "presentation" },
    "playlist": { "$ref": "schema-v5.json#/$defs/playlist" },
    "directFallbackPlaylist": { "$ref": "schema-v5.json#/$defs/playlist" },
    "playlists": {
      "type": "array",
      "items": { "$ref": "schema-v5.json#/$defs/playlist" }
    },
    "layout": { "$ref": "#/$defs/layout" },
    "directFallbackLayout": { "$ref": "#/$defs/layout" },
    "layouts": { "type": "array", "items": { "$ref": "#/$defs/layout" } },
    "schedules": { "type": "array", "items": { "$ref": "#/$defs/schedule" } },
    "assets": {
      "type": "array",
      "items": { "$ref": "schema-v1.json#/$defs/asset" }
    },
    "websites": {
      "type": "array",
      "items": { "$ref": "schema-v4.json#/$defs/website" }
    },
    "widgets": { "type": "array", "items": { "$ref": "#/$defs/widget" } },
    "dataSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataSource" }
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/$defs/plugin" }
    },
    "emergency": { "$ref": "schema-v4.json#/$defs/emergency" },
    "syncGroup": { "$ref": "schema-v9.json#/properties/syncGroup" },
    "prefetchHorizonDays": { "type": "integer", "minimum": 1, "maximum": 90 },
    "activationGraceSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    }
  },
  "$defs": {
    "plugin": {
      "description": "One built-in plugin surface delivered beside the presentation. Each type carries its own configuration; a Player ignores a type it does not implement.",
      "oneOf": [
        { "$ref": "#/$defs/countdownBarPlugin" },
        { "$ref": "#/$defs/alertTickerPlugin" }
      ]
    },
    "countdownBarPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version", "config"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "const": "countdown_bar" },
        "version": { "const": 1 },
        "config": { "$ref": "#/$defs/countdownBarConfig" }
      }
    },
    "alertTickerPlugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "version", "config"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "type": { "const": "alert_ticker" },
        "version": { "const": 1 },
        "config": { "$ref": "#/$defs/alertTickerConfig" }
      }
    },
    "alertTickerConfig": {
      "description": "A live emergency alert delivered as a bar rather than as a takeover. The message is composed by the server from the alert itself, so the Player renders text rather than resolving a schedule. `expiresAt` is the Player's own stop condition: a cached manifest must not keep showing an alert that may be over.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "message",
        "displayMode",
        "heightPx",
        "speed",
        "priority",
        "expiresAt"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "message": { "type": "string", "minLength": 1, "maxLength": 1000 },
        "severity": { "type": "string", "maxLength": 32 },
        "event": { "type": "string", "maxLength": 200 },
        "displayMode": { "enum": ["overlay", "push"] },
        "heightPx": { "type": "integer", "minimum": 40, "maximum": 320 },
        "speed": { "enum": ["slow", "medium", "fast"] },
        "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 },
        "expiresAt": { "type": "string", "format": "date-time" }
      }
    },
    "countdownBarConfig": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "message",
        "scheduleType",
        "timezone",
        "leadTimeSeconds",
        "displayMode",
        "heightPx",
        "priority"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "message": { "type": "string", "minLength": 1, "maxLength": 280 },
        "scheduleType": { "enum": ["weekly", "one_time"] },
        "targetTime": {
          "type": "string",
          "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9](:[0-5][0-9])?$"
        },
        "daysOfWeek": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "integer", "minimum": 0, "maximum": 6 }
        },
        "oneTimeAt": { "type": "string", "format": "date-time" },
        "timezone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "leadTimeSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 2592000
        },
        "completionText": { "type": "string", "maxLength": 280 },
        "showConfetti": { "type": "boolean" },
        "displayMode": { "enum": ["overlay", "push"] },
        "heightPx": { "type": "integer", "minimum": 40, "maximum": 320 },
        "progressFill": { "enum": ["none", "drain"] },
        "contentPadding": { "type": "integer", "minimum": 0, "maximum": 40 },
        "textScale": { "type": "integer", "minimum": 25, "maximum": 500 },
        "priority": { "type": "integer", "minimum": -1000, "maximum": 1000 }
      },
      "allOf": [
        {
          "if": { "properties": { "scheduleType": { "const": "weekly" } } },
          "then": { "required": ["targetTime", "daysOfWeek"] },
          "else": { "required": ["oneTimeAt"] }
        }
      ]
    },
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "description": "A renderable Widget. Data-driven Widgets reference a Data Source by dataSourceId inside configuration and never embed the cached dataset.",
      "required": [
        "assetId",
        "name",
        "provider",
        "configVersion",
        "configuration"
      ],
      "properties": {
        "assetId": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "provider": {
          "enum": [
            "website",
            "youtube",
            "clock",
            "date",
            "qrcode",
            "ticker",
            "menu",
            "list",
            "table",
            "agenda"
          ]
        },
        "configVersion": { "type": "integer", "minimum": 1 },
        "configuration": { "type": "object" }
      }
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "description": "A Data Source projected once and shared by every Widget or binding that consumes it. configuration carries the bounded cached dataset and the date-selection policy the Player applies locally.",
      "required": ["id", "name", "provider", "configVersion", "configuration"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "provider": {
          "enum": ["calendar", "rss", "atom", "json", "csv"]
        },
        "configVersion": { "type": "integer", "minimum": 1 },
        "configuration": { "type": "object" }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "revisionId",
        "revision",
        "documentSha256",
        "document"
      ],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "revisionId": { "type": "string", "format": "uuid" },
        "revision": { "type": "integer", "minimum": 1 },
        "documentSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "document": { "$ref": "../layout-schema/schema-v2.json" }
      }
    },
    "schedule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "timezone", "priority", "specificity"],
      "oneOf": [{ "required": ["playlistId"] }, { "required": ["layoutId"] }],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "playlistId": { "type": "string", "format": "uuid" },
        "layoutId": { "type": "string", "format": "uuid" },
        "type": { "enum": ["one_time", "weekly"] },
        "timezone": { "type": "string", "minLength": 1 },
        "priority": { "type": "integer", "minimum": -999, "maximum": 999 },
        "specificity": { "enum": [0, 1] },
        "startDate": { "type": "string", "format": "date" },
        "endDate": { "type": "string", "format": "date" },
        "oneTimeStart": { "type": "string", "format": "date-time" },
        "oneTimeEnd": { "type": "string", "format": "date-time" },
        "dailyStart": {
          "type": "string",
          "pattern": "^[0-2][0-9]:[0-5][0-9]$"
        },
        "dailyEnd": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
        "daysOfWeek": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 6 },
          "uniqueItems": true
        }
      }
    }
  }
}
