{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tilecast.org/schemas/player-manifest-v12.json",
  "title": "Tilecast typed Widget and Data Source presentation manifest v12",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "manifestVersion",
    "screenId",
    "generatedAt",
    "serverTime",
    "mode",
    "playlists",
    "layouts",
    "schedules",
    "assets",
    "websites",
    "widgets",
    "dataSources",
    "prefetchHorizonDays",
    "activationGraceSeconds"
  ],
  "properties": {
    "schemaVersion": { "const": 12 },
    "manifestVersion": { "type": "integer", "minimum": 1 },
    "screenId": { "type": "string", "format": "uuid" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "serverTime": { "type": "string", "format": "date-time" },
    "mode": { "const": "presentation" },
    "playlist": { "$ref": "schema-v5.json#/$defs/playlist" },
    "directFallbackPlaylist": { "$ref": "schema-v5.json#/$defs/playlist" },
    "playlists": {
      "type": "array",
      "items": { "$ref": "schema-v5.json#/$defs/playlist" }
    },
    "layout": { "$ref": "schema-v11.json#/$defs/layout" },
    "directFallbackLayout": { "$ref": "schema-v11.json#/$defs/layout" },
    "layouts": {
      "type": "array",
      "items": { "$ref": "schema-v11.json#/$defs/layout" }
    },
    "schedules": {
      "type": "array",
      "items": { "$ref": "schema-v11.json#/$defs/schedule" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "schema-v1.json#/$defs/asset" }
    },
    "websites": {
      "type": "array",
      "items": { "$ref": "schema-v4.json#/$defs/website" }
    },
    "widgets": { "type": "array", "items": { "$ref": "#/$defs/widget" } },
    "dataSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/dataSource" }
    },
    "plugins": {
      "type": "array",
      "items": { "$ref": "schema-v11.json#/$defs/plugin" }
    },
    "emergency": { "$ref": "schema-v4.json#/$defs/emergency" },
    "syncGroup": { "$ref": "schema-v9.json#/properties/syncGroup" },
    "prefetchHorizonDays": { "type": "integer", "minimum": 1, "maximum": 90 },
    "activationGraceSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    }
  },
  "$defs": {
    "widget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetId",
        "name",
        "provider",
        "configVersion",
        "configuration"
      ],
      "properties": {
        "assetId": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "provider": {
          "enum": [
            "website",
            "youtube",
            "clock",
            "date",
            "qrcode",
            "countdown",
            "ticker",
            "menu",
            "list",
            "table",
            "agenda",
            "metric",
            "cards",
            "weather"
          ]
        },
        "configVersion": { "type": "integer", "minimum": 1 },
        "configuration": { "type": "object" }
      }
    },
    "dataSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "provider", "configVersion", "configuration"],
      "properties": {
        "id": { "type": "string", "format": "uuid" },
        "name": { "type": "string", "minLength": 1, "maxLength": 180 },
        "provider": {
          "enum": [
            "calendar",
            "rss",
            "atom",
            "json",
            "csv",
            "manual",
            "weather"
          ]
        },
        "configVersion": { "type": "integer", "minimum": 1 },
        "configuration": { "$ref": "#/$defs/typedRecordData" }
      }
    },
    "typedRecordData": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fields", "records", "usingCachedData", "unavailable"],
      "properties": {
        "fields": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["key", "label", "type"],
            "properties": {
              "key": { "type": "string", "minLength": 1, "maxLength": 80 },
              "label": { "type": "string", "minLength": 1, "maxLength": 80 },
              "type": {
                "enum": [
                  "text",
                  "number",
                  "integer",
                  "percent",
                  "currency",
                  "boolean",
                  "date",
                  "datetime",
                  "url"
                ]
              }
            }
          }
        },
        "records": {
          "type": "array",
          "maxItems": 2000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "values"],
            "properties": {
              "id": { "type": "string", "minLength": 1, "maxLength": 80 },
              "values": {
                "type": "object",
                "maxProperties": 20,
                "additionalProperties": {
                  "type": "string",
                  "maxLength": 500
                }
              }
            }
          }
        },
        "cachedAt": { "type": "string", "format": "date-time" },
        "staleAt": { "type": "string", "format": "date-time" },
        "usingCachedData": { "type": "boolean" },
        "unavailable": { "type": "boolean" },
        "dateSelection": { "type": "object" },
        "dateField": { "type": "string", "maxLength": 80 },
        "attribution": { "type": "string", "maxLength": 160 }
      }
    }
  }
}
